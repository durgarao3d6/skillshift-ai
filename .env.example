# Schema-owner credential: migrations/provisioning only. Do NOT configure this on web/worker.
DATABASE_URL=postgresql://skillshift:skillshift@localhost:5432/skillshift
# Runtime role is provisioned separately and must not own tables or bypass RLS.
APP_DATABASE_URL=postgresql://skillshift_app:replace-me@localhost:5432/skillshift
APP_DATABASE_PASSWORD=replace-me
SESSION_SECRET=replace-with-at-least-32-random-characters
DELETION_HMAC_SECRET=replace-with-a-durable-separate-random-secret
APP_URL=http://localhost:3000
# Development only: production ignores this flag, regardless of its value.
SKILLSHIFT_DEMO_MODE=true
PRIVATE_STORAGE_PATH=.private-storage
# Production OIDC: exact issuer, pre-provisioned tenant membership, redirect /api/auth/callback.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# AI provider is optional; missing configuration routes tasks to explicit manual review.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_DATA_PROCESSING_APPROVED=false
DAILY_TOKEN_BUDGET=100000
ASSESSMENT_CONCURRENCY=2
REQUESTS_PER_MINUTE=120
DB_POOL_MAX=5
MAX_EVIDENCE_PER_DAY=5
MAX_EVIDENCE_BYTES_PER_TENANT=104857600
# Production evidence and deletion ledger use a PRIVATE encrypted S3 bucket.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLAMD_HOST=
CLAMD_PORT=3310
WORKER_TENANTS=11111111-1111-4111-8111-111111111111
WORKER_POLL_MS=2000
